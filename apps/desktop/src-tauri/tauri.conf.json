{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.2.3",
  "identifier": "app.jarvis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jarvis",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*",
      "freezePrototype": true
    },
    "trayIcon": {
      "id": "jarvis-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "Jarvis \u2014 AI assistant"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Jarvis",
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Personal AI computer assistant",
    "longDescription": "Jarvis is a local-first personal AI assistant for Windows. It understands natural language, controls the computer through native Windows APIs, and keeps the user in control of sensitive and destructive operations.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "binaries/jarvis-core": "core",
      "../../../plugins/word-count": "plugins/word-count"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/FawadHomaan2/AI-Assistant/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
